apiVersion: v1
kind: ConfigMap
metadata:
  name: {{ application }}-grafana-dashboard
  namespace: {{ namespace_name }}
  labels:
    grafana_dashboard: "1"

data:
  {{ application }}-dashboard.json: |
    {
      "id": null,
      "uid": "{{ application }}-{{ site }}",
      "title": "{{ application }} - {{ site }}",
      "tags": [
        "monitoring",
        "{{ tenant }}",
        "{{ application }}",
        "{{ site }}"
      ],
      "timezone": "browser",
      "schemaVersion": 39,
      "version": 1,
      "refresh": "30s",
      "time": {
        "from": "now-6h",
        "to": "now"
      },
      "panels": [
        {
          "id": 1,
          "title": "Total Pods",
          "type": "stat",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "targets": [
            {
              "expr": "count(kube_pod_info{namespace=\"{{ namespace_name }}\"})",
              "refId": "A"
            }
          ],
          "gridPos": {
            "h": 5,
            "w": 6,
            "x": 0,
            "y": 0
          }
        },
        {
          "id": 2,
          "title": "Running Pods",
          "type": "stat",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "targets": [
            {
              "expr": "count(kube_pod_status_phase{namespace=\"{{ namespace_name }}\", phase=\"Running\"} == 1)",
              "refId": "A"
            }
          ],
          "gridPos": {
            "h": 5,
            "w": 6,
            "x": 6,
            "y": 0
          }
        },
