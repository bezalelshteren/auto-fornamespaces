apiVersion: argoproj.io/v1alpha1
kind: Application
metadata:
  name: {{ cluster }}-{{ names.tenant }}-{{ names.application_name }}
  namespace: blackops-argocd-tenants
  labels:
    blackops/managed: "true"
    blackops/tenant: {{ names.tenant  }}
spec:
  project: {{ names.tenant }}-{{ names.lifecycle }}
  source:
    repoURL: {{ site.argocd.git_repo_url  }}
    targetRevision: master
    path: {{ cluster  }}
    helm:
      releaseName: {{ cluster }}-{{ names.lifecycle }}-{{ names.application_name }}
      valueFiles:
        - values.yaml
  destination:
    name: {{ cluster }}
    namespace: {{ names.namespace }}
